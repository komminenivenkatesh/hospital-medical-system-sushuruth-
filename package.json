{
  "name": "neurocare-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run db:start && npm run dev:all",
    "dev:all": "concurrently -k -n \"ML,BACKEND,FRONTEND\" -c \"magenta,cyan,green\" \"npm:dev:ml\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev": "npm run start",
    "dev:frontend": "vite --port 5175",
    "dev:backend": "node backend/server.js",
    "dev:ml": "python -u ml_service/app.py",
    "db:start": "powershell -Command \"Start-Service MongoDB -ErrorAction SilentlyContinue; exit 0\"",
    "seed": "node backend/seed.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/manrope": "^5.2.8",
    "@mui/icons-material": "^9.0.1",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.4.0",
    "@mui/x-date-pickers": "^9.4.0",
    "axios": "^1.19.0",
    "cobe": "^2.0.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
